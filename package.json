{
  "name": "graph-visualizer",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.15.0 <23 || >=24 <25 || >=26 <27",
    "npm": ">=11.6.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "scripts": {
    "dev": "deepspace dev start",
    "build": "vite build",
    "login": "deepspace auth login",
    "deploy": "deepspace deploy",
    "undeploy": "deepspace app undeploy",
    "add": "deepspace add",
    "test": "npm run validate && npm run test:e2e",
    "test:smoke": "playwright test --config tests/playwright.config.ts smoke.spec.ts",
    "test:api": "playwright test --config tests/playwright.config.ts api.spec.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "validate": "tsc --noEmit && vitest run",
    "screenshot": "deepspace test screenshot",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "dev:local": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "deepspace": "0.44.2",
    "hono": "^4.13.7",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@cloudflare/vite-plugin": "^1.33.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.10",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.14.1",
    "wrangler": "^4.79.0"
  },
  "private": true
}
